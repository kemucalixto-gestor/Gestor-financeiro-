# ===== Banco de dados (Turso / libSQL) =====
# Em desenvolvimento local, pode usar um arquivo SQLite:
#   TURSO_DATABASE_URL="file:./local.db"
# Em produção, crie um banco no Turso (https://turso.tech) e use a URL e token:
TURSO_DATABASE_URL="file:./local.db"
TURSO_AUTH_TOKEN=""

# ===== Auth.js =====
# Gere um segredo: openssl rand -base64 32
AUTH_SECRET="troque-isto-por-um-segredo-aleatorio-de-32-bytes"

# ===== Cron de recorrências =====
# Segredo usado no header x-cron-secret para acionar /api/recurring/run
RECURRING_CRON_SECRET="troque-isto-tambem"

# ===== Leitura automática de notas fiscais (opcional) =====
# Chave do Google Gemini (AI Studio) — https://aistudio.google.com
# Usada quando o usuário escaneia uma nota fiscal na tela de novo lançamento.
GOOGLE_API_KEY=""
